<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AiChanCompanion</AssemblyName>
    <RootNamespace>ElsaPetMod</RootNamespace>

    <!-- Caminhos base parametrizados -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDir>
    <ThunderstoreDir Condition="'$(ThunderstoreDir)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\REPO\profiles\(Profile With the mods)\BepInEx</ThunderstoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx Core -->
    <Reference Include="BepInEx">
      <HintPath>$(ThunderstoreDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(ThunderstoreDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game Assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\REPO_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity Modules -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\REPO_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Networking & Steamworks -->
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameDir)\REPO_Data\Managed\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="PhotonRealtime">
      <HintPath>$(GameDir)\REPO_Data\Managed\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Photon3Unity3D">
      <HintPath>$(GameDir)\REPO_Data\Managed\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Facepunch.Steamworks.Win64">
      <HintPath>$(GameDir)\REPO_Data\Managed\Facepunch.Steamworks.Win64.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Dependencies from Plugins -->
    <Reference Include="GenshinImpactOverhaulRepo">
      <HintPath>$(ThunderstoreDir)\plugins\GoblinKingShmee-GenshinImpactOverhaul_REPO\GenshinImpactOverhaulRepo.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="JigglePhysicsPlugin">
      <HintPath>$(ThunderstoreDir)\plugins\GoblinKingShmee-GenshinImpactOverhaul_REPO\JigglePhysicsPlugin.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="MenuLib">
      <HintPath>$(ThunderstoreDir)\plugins\nickklmao-MenuLib\MenuLib.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="RepoSteamNetworking">
      <HintPath>$(ThunderstoreDir)\plugins\Rune580-REPO_SteamNetworking_Lib\RepoSteamNetworking\RepoSteamNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>